{
  "files.eol": "\n",

  /**
   * JSON
   * ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄ */

  "json.schemas": [
    {
      "fileMatch": ["**/schema/bundle/spec.json"],
      "url": "./src/packages/openapi/src/schema/3.2/schema.json"
    },

    /**
     * Bundle fragments — one wrapper per components key, since the
     * spec publishes no per-component URLs. See schemas/README.md.
     * ──────────────────────────────────────── */

    {
      "fileMatch": ["**/schema/bundle/schemas/*.json"],
      "url": "./src/packages/openapi/src/schema/3.2/defs/components/schemas.json"
    },
    {
      "fileMatch": ["**/schema/bundle/responses/*.json"],
      "url": "./src/packages/openapi/src/schema/3.2/defs/components/responses.json"
    },
    {
      "fileMatch": ["**/schema/bundle/parameters/*.json"],
      "url": "./src/packages/openapi/src/schema/3.2/defs/components/parameters.json"
    },
    {
      "fileMatch": ["**/schema/bundle/examples/*.json"],
      "url": "./src/packages/openapi/src/schema/3.2/defs/components/examples.json"
    },
    {
      "fileMatch": ["**/schema/bundle/requestBodies/*.json"],
      "url": "./src/packages/openapi/src/schema/3.2/defs/components/requestBodies.json"
    },
    {
      "fileMatch": ["**/schema/bundle/headers/*.json"],
      "url": "./src/packages/openapi/src/schema/3.2/defs/components/headers.json"
    },
    {
      "fileMatch": ["**/schema/bundle/securitySchemes/*.json"],
      "url": "./src/packages/openapi/src/schema/3.2/defs/components/securitySchemes.json"
    },
    {
      "fileMatch": ["**/schema/bundle/links/*.json"],
      "url": "./src/packages/openapi/src/schema/3.2/defs/components/links.json"
    },
    {
      "fileMatch": ["**/schema/bundle/callbacks/*.json"],
      "url": "./src/packages/openapi/src/schema/3.2/defs/components/callbacks.json"
    },
    {
      "fileMatch": ["**/schema/bundle/pathItems/*.json"],
      "url": "./src/packages/openapi/src/schema/3.2/defs/fragments/pathItem.json"
    },
    {
      "fileMatch": ["**/schema/bundle/mediaTypes/*.json"],
      "url": "./src/packages/openapi/src/schema/3.2/defs/components/mediaTypes.json"
    }
  ],

  "json.schemaDownload.trustedDomains": {
    //
    /** ── OpenAPI ──────────────────── */

    "https://spec.openapis.org/": true,

    /** ── VSCode defaults ──────────────────── */

    "https://schemastore.azurewebsites.net/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://www.schemastore.org/": true,
    "https://json.schemastore.org/": true,
    "https://json-schema.org/": true,
    "https://developer.microsoft.com/json-schemas/": true
  }
}
