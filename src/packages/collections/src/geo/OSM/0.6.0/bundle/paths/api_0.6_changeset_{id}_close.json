    "summary": "Close a changeset",
    "tags": [
      "Changesets"
    ],
    "security": [
      {
        "oauth2": [
          "write_api"
        ]
      }
    ],
    "parameters": [
      {
        "$ref": "../components/parameters/changesetId.json"
      }
    ],
    "responses": {
      "200": {
        "description": "Changeset successfully closed"
      },
      "404": {
