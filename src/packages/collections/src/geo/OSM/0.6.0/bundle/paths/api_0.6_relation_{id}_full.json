      "200": {
        "description": "Relation and all directly referenced elements",
        "content": {
          "application/xml": {
            "schema": {
              "$ref": "../components/schemas/OsmXmlResponse.json"
            }
          },
          "application/json": {
            "schema": {
              "$ref": "../components/schemas/OsmJsonResponse.json"
            }
          }
        }
      },
      "404": {
        "$ref": "../components/responses/404.json"
      },
      "410": {
        "$ref": "../components/responses/410.json"
      }
    }
  }
