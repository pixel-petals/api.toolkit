{
  "get": {
    "summary": "List dataset facets",
    "operationId": "getRecordsFacets",
    "tags": [
      "Dataset"
    ],
    "description": "Enumerates facet values for records and returns a list of values for each facet.\nCan be used to implement guided navigation in large result sets.\n",
    "parameters": [
      {
        "$ref": "../components/parameters/dataset_id.json"
      },
      {
        "$ref": "../components/parameters/where.json"
      },
      {
        "$ref": "../components/parameters/refine.json"
      },
      {
        "$ref": "../components/parameters/exclude.json"
      },
      {
        "$ref": "../components/parameters/facet.json"
      },
      {
        "$ref": "../components/parameters/lang.json"
      },
      {
        "$ref": "../components/parameters/timezone.json"
      }
    ],
    "responses": {
      "200": {
        "description": "Facets enumeration",
        "content": {
          "application/json; charset=utf-8": {
            "schema": {
              "type": "object",
              "properties": {
                "links": {
                  "type": "array",
                  "items": {
                    "$ref": "../components/schemas/links.json"
                  }
                },
                "facets": {
                  "type": "array",
                  "items": {
                    "$ref": "../components/schemas/facet_enumeration.json"
                  }
                }
              }
            },
            "examples": {
              "facets": {
                "$ref": "../components/examples/facets.json"
              }
            }
          }
        }
      },
      "400": {
        "$ref": "../components/responses/bad_request.json"
      },
      "401": {
        "description": "Unauthorized"
      },
      "429": {
        "$ref": "../components/responses/quota.json"
      },
      "500": {
        "description": "Internal Server Error"
      }
    }
  }
}