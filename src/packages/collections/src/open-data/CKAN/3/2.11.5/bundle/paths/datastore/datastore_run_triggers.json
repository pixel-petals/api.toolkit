{
  "post": {
    "tags": [
      "DataStore"
    ],
    "operationId": "datastore_run_triggers",
    "security": [
      {
        "ApiToken": []
      }
    ],
    "summary": "Re-run triggers on all DataStore rows",
    "description": "Re-applies all existing trigger functions to every row in a DataStore table. Useful to revalidate/clean data after adding a new trigger.",
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "properties": {
              "resource_id": {
                "type": "string"
              }
            },
            "required": [
              "resource_id"
            ]
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "Row count updated",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../../components/schemas/ActionResponse.json"
            }
          }
        }
      },
      "403": {
        "$ref": "../../components/responses/AuthError.json"
      },
      "404": {
        "$ref": "../../components/responses/NotFound.json"
      }
    }
  }
}