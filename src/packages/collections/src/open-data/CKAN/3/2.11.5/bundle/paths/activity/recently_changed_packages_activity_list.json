{
  "get": {
    "tags": [
      "Activity"
    ],
    "operationId": "recently_changed_packages_activity_list",
    "summary": "Get site activity stream",
    "description": "Return the activity stream of all recently changed datasets on the site.",
    "parameters": [
      {
        "name": "limit",
        "in": "query",
        "description": "Max activities (default 31).",
        "schema": {
          "type": "integer",
          "default": 31
        }
      },
      {
        "name": "offset",
        "in": "query",
        "schema": {
          "type": "integer",
          "default": 0
        }
      },
      {
        "name": "after",
        "in": "query",
        "description": "Return activities after this timestamp.",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "before",
        "in": "query",
        "description": "Return activities before this timestamp.",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "include_data",
        "in": "query",
        "description": "Include snapshot data in each activity.",
        "schema": {
          "type": "boolean",
          "default": false
        }
      },
      {
        "name": "include_hidden_activity",
        "in": "query",
        "schema": {
          "type": "boolean",
          "default": false
        }
      }
    ],
    "security": [],
    "responses": {
      "200": {
        "description": "List of activity dicts",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../../components/schemas/ActionResponse.json"
            }
          }
        }
      },
      "403": {
        "$ref": "../../components/responses/AuthError.json"
      },
      "404": {
        "$ref": "../../components/responses/NotFound.json"
      }
    }
  }
}