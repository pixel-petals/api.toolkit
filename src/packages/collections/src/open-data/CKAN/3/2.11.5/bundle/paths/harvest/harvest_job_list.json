{
  "get": {
    "tags": [
      "Harvest"
    ],
    "operationId": "harvest_job_list",
    "summary": "List harvest jobs for a source",
    "description": "Return the list of harvest jobs for a given source.",
    "parameters": [
      {
        "name": "source_id",
        "in": "query",
        "required": true,
        "description": "Harvest source id.",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "status",
        "in": "query",
        "description": "Filter by status.",
        "schema": {
          "type": "string",
          "enum": [
            "New",
            "Running",
            "Finished",
            "Error"
          ]
        }
      }
    ],
    "responses": {
      "200": {
        "description": "List of harvest job dicts",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../../components/schemas/ActionResponse.json"
            }
          }
        }
      },
      "404": {
        "$ref": "../../components/responses/NotFound.json"
      }
    }
  }
}