{
  "get": {
    "tags": [
      "Campaigns"
    ],
    "operationId": "getCampaignPosts",
    "summary": "List posts for a campaign",
    "description": "Returns all posts on a given Campaign.\n\n**Scope:** `campaigns.posts`\n\nAll post attributes must be requested via `fields[post]=...`",
    "security": [
      {
        "OAuth2": []
      },
      {
        "BearerToken": []
      }
    ],
    "parameters": [
      {
        "name": "campaign_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      {
        "$ref": "../../components/parameters/fields.json"
      },
      {
        "$ref": "../../components/parameters/include.json"
      },
      {
        "name": "fields[post]",
        "in": "query",
        "schema": {
          "type": "string"
        },
        "description": "Post attributes. E.g. `title,content,url,published_at,is_public,is_paid`."
      },
      {
        "$ref": "../../components/parameters/pageCursor.json"
      },
      {
        "$ref": "../../components/parameters/pageCount.json"
      }
    ],
    "responses": {
      "200": {
        "description": "Paginated list of campaign posts.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../../components/schemas/JsonApiListResponse.json"
            }
          }
        }
      },
      "400": {
        "$ref": "../../components/responses/BadRequest.json"
      },
      "401": {
        "$ref": "../../components/responses/Unauthorized.json"
      },
      "403": {
        "$ref": "../../components/responses/Forbidden.json"
      },
      "404": {
        "$ref": "../../components/responses/NotFound.json"
      },
      "429": {
        "$ref": "../../components/responses/TooManyRequests.json"
      },
      "500": {
        "$ref": "../../components/responses/ServerError.json"
      }
    }
  }
}