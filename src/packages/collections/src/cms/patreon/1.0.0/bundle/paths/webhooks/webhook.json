{
  "patch": {
    "tags": [
      "Webhooks"
    ],
    "operationId": "updateWebhook",
    "summary": "Update a webhook",
    "description": "Update the triggers, URI, or paused state of a webhook. You can only update webhooks created by your client.\n\n**Note:** To resend queued missed events after webhook downtime, PATCH with `paused: false`.",
    "security": [
      {
        "OAuth2": []
      },
      {
        "BearerToken": []
      }
    ],
    "parameters": [
      {
        "name": "webhook_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    ],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "required": [
              "data"
            ],
            "properties": {
              "data": {
                "type": "object",
                "required": [
                  "id",
                  "type"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "webhook"
                    ]
                  },
                  "attributes": {
                    "type": "object",
                    "properties": {
                      "paused": {
                        "type": "boolean"
                      },
                      "triggers": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "uri": {
                        "type": "string",
                        "format": "uri"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "Updated webhook.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../../components/schemas/JsonApiSingleResponse.json"
            }
          }
        }
      },
      "400": {
        "$ref": "../../components/responses/BadRequest.json"
      },
      "401": {
        "$ref": "../../components/responses/Unauthorized.json"
      },
      "403": {
        "$ref": "../../components/responses/Forbidden.json"
      },
      "404": {
        "$ref": "../../components/responses/NotFound.json"
      },
      "429": {
        "$ref": "../../components/responses/TooManyRequests.json"
      },
      "500": {
        "$ref": "../../components/responses/ServerError.json"
      }
    }
  },
  "delete": {
    "tags": [
      "Webhooks"
    ],
    "operationId": "deleteWebhook",
    "summary": "Delete a webhook",
    "description": "Permanently delete a webhook created by your client.",
    "security": [
      {
        "OAuth2": []
      },
      {
        "BearerToken": []
      }
    ],
    "parameters": [
      {
        "name": "webhook_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    ],
    "responses": {
      "204": {
        "description": "Webhook deleted."
      },
      "400": {
        "$ref": "../../components/responses/BadRequest.json"
      },
      "401": {
        "$ref": "../../components/responses/Unauthorized.json"
      },
      "403": {
        "$ref": "../../components/responses/Forbidden.json"
      },
      "404": {
        "$ref": "../../components/responses/NotFound.json"
      },
      "429": {
        "$ref": "../../components/responses/TooManyRequests.json"
      },
      "500": {
        "$ref": "../../components/responses/ServerError.json"
      }
    }
  }
}