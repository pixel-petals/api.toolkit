{
  "metapak": {
    "configs": [
      "main"
    ]
  },
  "name": "@px-petals/api.spec",
  "version": "0.0.1",
  "private": true,
  "author": "Pixel Petals",
  "repository": {
    "url": "https://github.com/pixel-petals/api.spec",
    "type": "git"
  },
  "description": "Vendored API specification schemas, split into per-object fragments an editor can validate against.",
  "// EXPORTS": "■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■",
  "scripts": {
    "dependencies": "packager link || exit 0",
    "lint": "eslint .",
    "metapak": "metapak-px",
    "package:arazzo": "npm run --workspace @package/arazzo",
    "package:asyncapi": "npm run --workspace @package/asyncapi",
    "package:collections": "npm run --workspace @package/collections",
    "package:graphql": "npm run --workspace @package/graphql",
    "package:mcp": "npm run --workspace @package/mcp",
    "package:openapi": "npm run --workspace @package/openapi",
    "package:protobuf": "npm run --workspace @package/protobuf",
    "package:typeapi": "npm run --workspace @package/typeapi",
    "test": "ws-run test",
    "typecheck": "ws-run typecheck",
    "util:api": "npm run --workspace @util/api"
  },
  "// USES": "■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■",
  "workspaces": [
    "src/.tests/*",
    "src/apps/*",
    "src/packages/*",
    "src/plugins/*",
    "src/tools/*",
    "src/utils/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {},
  "devDependencies": {
    "@px-petals/metapak-dependencies": "github:pixel-petals/.dependencies",
    "@px-petals/shell.toolkit": "github:pixel-petals/shell.toolkit",
    "@px-petals/tools.packager": "github:pixel-petals/tools.packager",
    "@px-petals/web.toolkit": "github:pixel-petals/web.toolkit",
    "@types/node": "24.13.6",
    "eslint": "9.39.5",
    "metapak": "7.1.1",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "type": "module"
}