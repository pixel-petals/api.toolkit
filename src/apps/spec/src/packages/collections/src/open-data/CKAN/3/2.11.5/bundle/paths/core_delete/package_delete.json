          "schema": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "The id or name of the dataset to delete."
              }
            },
            "required": [
              "id"
            ]
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "Deleted dataset dict",
