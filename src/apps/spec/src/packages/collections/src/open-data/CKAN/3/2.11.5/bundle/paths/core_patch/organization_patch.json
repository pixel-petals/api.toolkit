{
  "post": {
    "tags": [
      "Organizations"
    ],
    "operationId": "organization_patch",
    "security": [
      {
        "ApiToken": []
      }
    ],
    "summary": "Partially update a organization",
    "description": "Update only the provided fields of a organization. Unspecified fields retain their current values. Contrast with `organization_update` which does a full replace.",
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "Updated organization dict",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../../components/schemas/ActionResponse.json"
            }
          }
        }
      },
      "403": {
        "$ref": "../../components/responses/AuthError.json"
      },
      "404": {
        "$ref": "../../components/responses/NotFound.json"
      }
    }
  }
}