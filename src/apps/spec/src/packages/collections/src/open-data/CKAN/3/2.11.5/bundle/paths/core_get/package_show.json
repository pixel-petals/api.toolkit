{
  "get": {
    "tags": [
      "Packages"
    ],
    "operationId": "package_show",
    "summary": "Get a dataset",
    "description": "Return the metadata of a dataset (package) and its resources.",
    "parameters": [
      {
        "name": "id",
        "in": "query",
        "required": true,
        "description": "Dataset id or name.",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "use_default_schema",
        "in": "query",
        "description": "If True, use the default schema instead of any custom one.",
        "schema": {
          "type": "boolean"
        }
      },
      {
        "name": "include_tracking",
        "in": "query",
        "description": "Include page-view tracking info.",
        "schema": {
          "type": "boolean"
        }
      }
    ],
    "responses": {
      "200": {
        "description": "Dataset dict.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../../components/schemas/ActionResponse.json"
            }
          }
        }
      },
      "403": {
        "$ref": "../../components/responses/AuthError.json"
      },
      "404": {
        "$ref": "../../components/responses/NotFound.json"
      }
    }
  }
}