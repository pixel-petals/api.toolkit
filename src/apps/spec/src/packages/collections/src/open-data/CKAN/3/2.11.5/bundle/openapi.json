    {
      "name": "Packages",
      "description": "Datasets (packages) \u2014 the core CKAN content unit. Create, read, update, delete, and search datasets."
    },
    {
      "name": "Resources",
      "description": "Data resources attached to datasets. Supports FileStore uploads (multipart/form-data) and external URL links."
    },
    {
      "name": "Groups",
      "description": "Thematic collections grouping related datasets."
    },
    {
      "name": "Organizations",
      "description": "Publisher organizations that own and manage datasets."
    },
    {
      "name": "Users",
      "description": "User accounts, profiles, and roles."
    },
    {
      "name": "Tags",
      "description": "Free tags and controlled vocabulary terms for dataset tagging."
    },
    {
      "name": "Members",
      "description": "Membership management for groups and organizations."
    },
    {
      "name": "Following",
      "description": "Follow / unfollow datasets, users, and groups."
    },
    {
      "name": "Auth",
      "description": "API token management (create, list, revoke)."
    },
    {
      "name": "Jobs",
      "description": "Background job queue (list, show, cancel). Sysadmin only."
    },
    {
      "name": "System",
      "description": "Site status, license list, configuration options."
    },
    {
      "name": "FileStore",
      "description": "CKAN FileStore: file uploads via resource_create/update, DataStore dump downloads, and CKAN 2.12+ File API."
    },
    {
      "name": "DataStore",
      "description": "ckanext-datastore: structured tabular storage with search, filter, upsert, SQL queries, and trigger functions."
    },
    {
      "name": "Activity",
      "description": "ckanext-activity: activity streams and audit trail for all CKAN objects."
    },
    {
      "name": "Harvest",
      "description": "ckanext-harvest: remote metadata ingestion from CKAN, WAF, CSW, DCAT, and other sources."
    },
    {
      "name": "Spatial",
      "description": "ckanext-spatial: spatial bounding box search extension to package_search."
    },
    {
      "name": "DCAT",
      "description": "ckanext-dcat: RDF/DCAT catalog and dataset serialization endpoints (Turtle, JSON-LD, RDF/XML)."
    }
  ],
