{
  "get": {
    "tags": [
      "Packages"
    ],
    "operationId": "package_list",
    "summary": "List dataset names",
    "description": "Return a list of the names of the site's datasets (packages). GET-able.",
    "parameters": [
      {
        "name": "limit",
        "in": "query",
        "description": "Max datasets per page.",
        "schema": {
          "type": "integer"
        }
      },
      {
        "name": "offset",
        "in": "query",
        "schema": {
          "type": "integer",
          "default": 0
        }
      }
    ],
    "responses": {
      "200": {
        "description": "List of dataset name strings",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../../components/schemas/ActionResponse.json"
            }
          }
        }
      },
      "403": {
        "$ref": "../../components/responses/AuthError.json"
      }
    }
  },
  "post": {
    "tags": [
      "Packages"
    ],
    "operationId": "package_list_post",
    "summary": "List dataset names (POST)",
    "description": "Same as GET, via POST body.",
    "requestBody": {
      "required": false,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "properties": {
              "limit": {
                "type": "integer"
              },
              "offset": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "List of dataset name strings",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../../components/schemas/ActionResponse.json"
            }
          }
        }
      },
      "403": {
        "$ref": "../../components/responses/AuthError.json"
      }
    }
  }
}