{
  "post": {
    "tags": [
      "GeoEnrichment Service"
    ],
    "operationId": "createEnrichmentReport",
    "summary": "Generate a demographic or business report",
    "description": "Generates a PDF or Excel report summarising demographics, tapestry market segments, business data, or market potential for a study area.",
    "requestBody": {
      "required": true,
      "content": {
        "application/x-www-form-urlencoded": {
          "schema": {
            "type": "object",
            "required": [
              "studyAreas",
              "report"
            ],
            "properties": {
              "studyAreas": {
                "type": "string"
              },
              "report": {
                "type": "string",
                "description": "Report template: `esri_demographics`, `esri_tapestry`, `business_summary`, `market_potential`."
              },
              "format": {
                "type": "string",
                "enum": [
                  "PDF",
                  "XLSX"
                ],
                "default": "PDF"
              },
              "studyAreasOptions": {
                "type": "string"
              },
              "inSR": {
                "type": "integer"
              },
              "f": {
                "type": "string",
                "default": "json"
              }
            }
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "Report as base64-encoded content.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object"
            }
          }
        }
      },
      "400": {
        "$ref": "../../components/responses/ArcGISError.json"
      },
      "401": {
        "$ref": "../../components/responses/Unauthorized.json"
      }
    }
  }
}