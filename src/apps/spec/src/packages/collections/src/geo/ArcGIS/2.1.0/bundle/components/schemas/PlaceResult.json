{
  "type": "object",
  "properties": {
    "placeId": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "location": {
      "$ref": "./Location.json"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "categoryId": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "icon": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "contentType": {
          "type": "string"
        }
      }
    }
  }
}