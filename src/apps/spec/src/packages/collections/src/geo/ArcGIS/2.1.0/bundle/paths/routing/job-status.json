{
  "get": {
    "tags": [
      "Routing Service"
    ],
    "operationId": "getRoutingJobStatus",
    "summary": "Poll async routing job status",
    "description": "Returns current status of an async routing job. Poll until `jobStatus` is `esriJobSucceeded` or `esriJobFailed`, then retrieve results from the `results` links.",
    "parameters": [
      {
        "name": "jobId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      {
        "$ref": "../../components/parameters/f.json"
      }
    ],
    "responses": {
      "200": {
        "description": "Job status.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../../components/schemas/JobStatus.json"
            }
          }
        }
      },
      "404": {
        "$ref": "../../components/responses/NotFound.json"
      }
    }
  }
}