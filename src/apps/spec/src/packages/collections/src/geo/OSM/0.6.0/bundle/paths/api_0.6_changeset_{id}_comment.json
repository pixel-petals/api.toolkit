{
  "post": {
    "operationId": "commentOnChangeset",
    "summary": "Add a comment to a closed changeset",
    "tags": [
      "Changeset Discussion"
    ],
    "security": [
      {
        "oauth2": [
          "write_api"
        ]
      }
    ],
    "parameters": [
      {
        "$ref": "../components/parameters/changesetId.json"
      }
    ],
    "requestBody": {
      "required": true,
      "content": {
        "application/x-www-form-urlencoded": {
          "schema": {
            "type": "object",
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string",
                "description": "The comment text"
              }
            }
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "Updated changeset with the new comment",
        "content": {
          "application/xml": {
            "schema": {
              "$ref": "../components/schemas/OsmXmlResponse.json"
            }
          }
        }
      },
      "400": {
        "$ref": "../components/responses/400.json"
      },
      "401": {
        "$ref": "../components/responses/401.json"
      },
      "409": {
        "description": "Changeset is not closed"
      }
    }
  }
}