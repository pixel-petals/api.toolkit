{
  "type": "object",
  "description": "OAuth 2.0 token response.",
  "properties": {
    "access_token": {
      "type": "string"
    },
    "refresh_token": {
      "type": "string"
    },
    "expires_in": {
      "type": "integer",
      "description": "Token lifetime in seconds."
    },
    "scope": {
      "type": "string",
      "description": "Space-separated list of granted scopes."
    },
    "token_type": {
      "type": "string",
      "example": "Bearer"
    }
  },
  "required": [
    "access_token",
    "token_type"
  ]
}